generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  hashedPassword String?
  role           Role          @default(ADMIN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  hospitalUser   HospitalUser?
  staffProfile   StaffProfile?
}

model StaffProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  languagesSpoken String[]
  managedCases    PatientCase[] @relation("CaseManager")
  translatedCases PatientCase[] @relation("CaseTranslator")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model City {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  state       String?
  country     String        @default("India")
  description String?
  imageUrl    String?
  translations Json?
  doctors     Doctor[]
  hospitals   Hospital[]
  cases       PatientCase[] @relation("PreferredCity")
}

model Specialty {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  imageUrl    String?
  translations Json?
  conditions  Condition[]
  doctors     Doctor[]
  treatments  Treatment[]
  hospitals   Hospital[]  @relation("HospitalSpecialties")
}

model Condition {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String?
  translations      Json?
  specialtyId       String
  causesAndSymptoms String[]  @default([])
  diagnosis         String[]  @default([])
  faqs              Json?
  treatmentOptions  String[]  @default([])
  specialty         Specialty @relation(fields: [specialtyId], references: [id])
}

model Treatment {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  description       String?
  minEstimate       Float?
  maxEstimate       Float?
  currency          String         @default("USD")
  overview          String?
  procedure         String?
  recovery          String?
  risks             String?
  translations      Json?
  specialtyId       String
  causesAndSymptoms String[]
  diagnosis         String[]
  faqs              Json?
  postOpCare        String[]
  preOpPrep         String[]
  procedureDetails  String[]
  quotes            CaseQuote[]
  patientCases      PatientCase[]
  stories           PatientStory[]
  specialty         Specialty      @relation(fields: [specialtyId], references: [id])
  doctors           Doctor[]       @relation("TreatmentToDoctor")
  hospitals         Hospital[]     @relation("TreatmentToHospital")
}

model Hospital {
  id                    String         @id @default(cuid())
  name                  String
  slug                  String         @unique
  description           String?
  address               String?
  translations          Json?
  cityId                String
  beds                  Int?
  icuBeds               Int?
  otCount               Int?
  accreditations        String[]
  internationalServices String[]
  established           Int?
  airportDistance       Int?
  premiumFacilities     String[]       @default([])
  advancedTechnologies  String[]       @default([])
  connectivityLocation  String[]       @default([])
  excellenceInCare      String[]       @default([])
  multiSpecialties      String[]       @default([])
  hospitalFacilities    Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  imageUrl              String?
  caseAssignments       CaseHospital[]
  quotes                CaseQuote[]
  doctors               Doctor[]
  city                  City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  users                 HospitalUser[]
  specialties           Specialty[]    @relation("HospitalSpecialties")
  treatments            Treatment[]    @relation("TreatmentToHospital")
}

model HospitalUser {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String
  position   String?
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Doctor {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  qualifications         String?
  medicalQualifications  String[]       @default([])
  professionalExperience String[]       @default([])
  specialInterests       String[]       @default([])
  careerHighlights       String[]       @default([])
  researchFellowships    String[]       @default([])
  awardsRecognitions     String[]       @default([])
  allTreatments          String[]       @default([])
  experienceYears        Int?
  biography              String?
  translations           Json?
  imageUrl               String?
  hospitalId             String
  specialtyId            String
  cityId                 String?
  recommendedIn          CaseHospital[]
  city                   City?          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  hospital               Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty              Specialty      @relation(fields: [specialtyId], references: [id])
  treatments             Treatment[]    @relation("TreatmentToDoctor")
}

model Patient {
  id        String        @id @default(cuid())
  firstName String
  lastName  String?
  email     String
  phone     String?
  country   String?
  age       Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  dob       DateTime?
  cases     PatientCase[]
}

model PatientCase {
  id               String              @id @default(cuid())
  referenceId      String              @unique
  patientId        String
  medicalCondition String?
  treatmentId      String?
  preferredCityId  String?
  budget           Float?
  currency         String              @default("USD")
  status           CaseStatus          @default(NEW)
  managerId        String?
  translatorId     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  documents        CaseDocument[]
  hospitals        CaseHospital[]
  notes            CaseNote[]
  quotes           CaseQuote[]
  statusHistory    CaseStatusHistory[]
  commissions      Commission[]
  manager          StaffProfile?       @relation("CaseManager", fields: [managerId], references: [id])
  patient          Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  preferredCity    City?               @relation("PreferredCity", fields: [preferredCityId], references: [id])
  translator       StaffProfile?       @relation("CaseTranslator", fields: [translatorId], references: [id])
  treatment        Treatment?          @relation(fields: [treatmentId], references: [id])
}

model CaseStatusHistory {
  id        String      @id @default(cuid())
  caseId    String
  status    CaseStatus
  changedBy String?
  notes     String?
  createdAt DateTime    @default(now())
  case      PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id         String      @id @default(cuid())
  caseId     String
  fileName   String
  fileUrl    String
  fileType   String
  isPrivate  Boolean     @default(true)
  uploadedAt DateTime    @default(now())
  case       PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseHospital {
  id                  String      @id @default(cuid())
  caseId              String
  hospitalId          String
  recommendedDoctorId String?
  status              String      @default("CONTACTED")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  case                PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hospital            Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  recommendedDoctor   Doctor?     @relation(fields: [recommendedDoctorId], references: [id])

  @@unique([caseId, hospitalId])
}

model CaseQuote {
  id          String      @id @default(cuid())
  caseId      String
  hospitalId  String
  treatmentId String
  amount      Float
  currency    String      @default("USD")
  details     String?
  documentUrl String?
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  case        PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatment   Treatment   @relation(fields: [treatmentId], references: [id])
}

model CaseNote {
  id         String      @id @default(cuid())
  caseId     String
  authorId   String
  content    String
  isInternal Boolean     @default(true)
  createdAt  DateTime    @default(now())
  case       PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Commission {
  id             String           @id @default(cuid())
  caseId         String
  treatmentValue Float
  percentage     Float
  amount         Float
  currency       String           @default("USD")
  status         CommissionStatus @default(PENDING)
  invoiceRef     String?
  dueDate        DateTime?
  receivedDate   DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  case           PatientCase      @relation(fields: [caseId], references: [id])
}

model PatientStory {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  patientName String
  content     String
  imageUrl    String?
  translations Json?
  treatmentId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  treatment   Treatment? @relation(fields: [treatmentId], references: [id])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("General")
  imageUrl  String
  createdAt DateTime @default(now())
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  translations Json?
  authorName String   @default("Admin")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  CASE_MANAGER
  TRANSLATOR
  COORDINATOR
  HOSPITAL_USER
}

enum CaseStatus {
  NEW
  UNDER_REVIEW
  ASSIGNED
  HOSPITAL_MATCHING
  HOSPITAL_CONTACTED
  QUOTE_PENDING
  QUOTE_RECEIVED
  PATIENT_REVIEWING
  TRAVEL_PLANNING
  ADMITTED
  TREATMENT_IN_PROGRESS
  TREATMENT_COMPLETED
  FOLLOW_UP
  COMPLETED
  CANCELLED
  LOST
  DUPLICATE
}

enum CommissionStatus {
  PENDING
  EXPECTED
  INVOICED
  RECEIVED
  CANCELLED
}
